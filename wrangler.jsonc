{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"compatibility_date": "2026-08-10",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "zhgmx.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"compatibility_flags": ["nodejs_compat"]
}
